<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_20"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_free_badge"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_emoji_smile"
                        app:tint="@color/md_on_free_badge" />

                    <TextView
                        android:id="@+id/free_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/md_on_free_badge" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_usage"
                    style="@style/Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="@string/reset" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                style="@style/Widget.FishPipe.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:hint="@string/home_hint"
                app:endIconContentDescription="@string/paste_clipboard"
                app:endIconDrawable="@drawable/ic_paste"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resolve"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/resolve" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/banner_clipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardCornerRadius="@dimen/radius_sm"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_12"
                    android:paddingTop="@dimen/space_6"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/link_detected"
                        android:src="@drawable/ic_link"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        android:id="@+id/clipboard_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/link_detected"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnTertiaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_use_clipboard"
                        style="@style/Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_link"
                        android:textColor="?attr/colorOnTertiaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    style="@style/Widget.FishPipe.Loading.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:text="@string/resolving"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="?attr/colorSurfaceContainerHigh">

                        <ImageView
                            android:id="@+id/result_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/preview"
                            android:scaleType="centerCrop" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/result_play"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/preview"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:padding="12dp"
                            android:text=""
                            app:backgroundTint="@color/scrim"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <LinearLayout
                            android:id="@+id/result_creator_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/result_author"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/result_dot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_4"
                                android:text="@string/meta_dot"
                                android:textColor="?attr/colorOutline" />

                            <TextView
                                android:id="@+id/result_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_4"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/result_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.theuncoaffair.fishpipe.util.HashtagTextView
                            android:id="@+id/result_hashtags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/result_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOutline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:baselineAligned="false"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_insights"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/insights_title"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:padding="10dp"
                                android:text=""
                                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                                app:cornerRadius="22dp"
                                app:icon="@drawable/ic_insights"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="?attr/colorOnSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_link"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:contentDescription="@string/copy_link"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:padding="10dp"
                                android:text=""
                                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                                app:cornerRadius="22dp"
                                app:icon="@drawable/ic_copy"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="?attr/colorOnSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_open_source"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:contentDescription="@string/open_source"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:padding="10dp"
                                android:text=""
                                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                                app:cornerRadius="22dp"
                                app:icon="@drawable/ic_open"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="?attr/colorOnSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_batch"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:contentDescription="@string/batch_download"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:padding="10dp"
                                android:text=""
                                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                                app:cornerRadius="22dp"
                                app:icon="@drawable/ic_batch"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="?attr/colorOnSurface" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download_video"
                            style="@style/Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/touch"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/download" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_tip"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
