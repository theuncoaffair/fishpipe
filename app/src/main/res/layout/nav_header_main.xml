<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="0dp"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_16">

    <View
        android:id="@+id/header_status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/drawer_logo"
            android:layout_height="@dimen/drawer_logo"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:contentDescription="@null"
            android:src="@drawable/ic_emoji_smile"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/header_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_8" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_stay_in_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch"
        android:text="@string/drawer_stay_in_app"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_auto_detect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch"
        android:text="@string/auto_detect"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_auto_download"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch"
        android:text="@string/drawer_auto_download"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
</LinearLayout>
