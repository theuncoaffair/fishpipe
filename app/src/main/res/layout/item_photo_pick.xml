<?xml version="1.0" encoding="utf-8"?>
<com.theuncoaffair.fishpipe.util.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/photo_sheet_title"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/photo_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/photo_dim"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/photo_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_check_checked"
        android:contentDescription="@string/select"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        app:tint="@color/white" />
</com.theuncoaffair.fishpipe.util.SquareFrameLayout>
