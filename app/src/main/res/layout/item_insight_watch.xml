<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_10"
    android:paddingBottom="@dimen/space_4">

    <CheckBox
        android:id="@+id/watch_check"
        android:layout_width="@dimen/icon_action"
        android:layout_height="@dimen/icon_action"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <com.theuncoaffair.fishpipe.util.CircleImageView
        android:id="@+id/watch_avatar"
        android:layout_width="@dimen/avatar_small"
        android:layout_height="@dimen/avatar_small"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_10"
        android:paddingEnd="@dimen/space_8">

        <TextView
            android:id="@+id/watch_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/watch_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOutline"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/watch_more"
        android:layout_width="@dimen/icon_action"
        android:layout_height="@dimen/icon_action"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu"
        android:padding="@dimen/space_8"
        android:src="@drawable/ic_more"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
