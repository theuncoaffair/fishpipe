<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout
                android:id="@+id/appearance_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/appearance_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:text="@string/theme_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <include
                    android:id="@+id/row_theme_system"
                    layout="@layout/item_settings_choice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:layout_marginTop="@dimen/space_2" />

                <include
                    android:id="@+id/row_theme_light"
                    layout="@layout/item_settings_choice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:layout_marginTop="@dimen/space_2" />

                <include
                    android:id="@+id/row_theme_dark"
                    layout="@layout/item_settings_choice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:layout_marginTop="@dimen/space_2" />

                <include
                    android:id="@+id/row_theme_amoled"
                    layout="@layout/item_settings_choice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:layout_marginTop="@dimen/space_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resolver_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resolver_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:text="@string/custom_resolver_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/resolver_url_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/resolver_url"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/resolver_url_layout"
                    style="@style/Widget.FishPipe.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="@string/custom_resolver_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/resolver_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/resolver_key_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:text="@string/resolver_key_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/resolver_key_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/resolver_key_option"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/resolver_key_layout"
                    style="@style/Widget.FishPipe.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="@string/resolver_key_hint"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/resolver_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notifications_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:letterSpacing="0.04"
                    android:text="@string/download_section"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/row_notify_progress"
                    layout="@layout/item_settings_value"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height" />

                <include
                    android:id="@+id/row_notify_complete"
                    layout="@layout/item_settings_value"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height" />

                <TextView
                    android:id="@+id/notifications_embed_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:letterSpacing="0.04"
                    android:text="@string/embed_captions_section"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/row_notify_embed_start"
                    layout="@layout/item_settings_value"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height" />

                <include
                    android:id="@+id/row_notify_embed_finished"
                    layout="@layout/item_settings_value"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_tiny" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:text="@string/tagline"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/about_whats_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/about_bug_fixes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/update_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/update_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/update_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/detail_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_16"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_action"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
