<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insights_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

    <ScrollView
        android:id="@+id/insights_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/insights_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_small" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_banner"
                android:padding="12dp"
                android:text="@string/insights_private_notice"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_tiny" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/insights_input_layout"
                style="@style/Widget.FishPipe.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/insights_hint"
                app:endIconContentDescription="@string/paste_clipboard"
                app:endIconDrawable="@drawable/ic_paste"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/insights_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_insights_analyze"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/insights_analyze" />

            <LinearLayout
                android:id="@+id/watchlist_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/watchlist_header"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/watchlist_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/insights_watchlist_section"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/watchlist_more"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/menu"
                        android:padding="7dp"
                        android:src="@drawable/ic_more"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/watchlist_chevron"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/watchlist_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/watchlist_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/insights_watchlist_hint"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_tiny" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/watchlist_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/watchlist_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="@dimen/space_2"
                        android:paddingTop="@dimen/space_2"
                        android:paddingBottom="@dimen/space_8"
                        android:text="@string/insights_watchlist_empty"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_small"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insights_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    style="@style/Widget.FishPipe.Loading.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/insights_analyzing"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insights_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/insights_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/insights_retry"
                    style="@style/Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch"
                    android:layout_marginTop="10dp"
                    android:text="@string/retry" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insights_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/profile_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.theuncoaffair.fishpipe.util.CircleImageView
                            android:id="@+id/profile_avatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@string/insights_creator_section"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_explore" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/profile_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/text_heading"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/profile_verified"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/insights_verified"
                                    android:textColor="?attr/colorTertiary"
                                    android:textSize="@dimen/text_tiny"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/profile_handle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_small" />

                            <TextView
                                android:id="@+id/profile_signature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="?attr/colorOutline"
                                android:textSize="@dimen/text_tiny" />

                            <TextView
                                android:id="@+id/profile_bio_link"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:autoLink="web"
                                android:background="?android:attr/selectableItemBackground"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_tiny"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/profile_collapse"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand_less"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/profile_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_profile_open"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:clickable="true"
                            android:contentDescription="@string/insights_open_profile"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tiktok_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/insights_open_profile"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_profile_watch"
                            style="@style/Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/insights_watch" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/video_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="?attr/colorSurfaceContainerHigh">

                        <ImageView
                            android:id="@+id/video_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/insights_video_section"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/video_collapse"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/space_8"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_expand_less"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/video_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/video_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/video_hashtags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="1dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_tiny"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/video_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/colorOutline"
                            android:textSize="@dimen/text_tiny" />

                        <LinearLayout
                            android:id="@+id/video_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/video_rates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/btn_video_open"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/touch"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_button_secondary"
                            android:clickable="true"
                            android:contentDescription="@string/insights_open_video"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tiktok_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/insights_open_video"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/creator_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/insights_creator_section"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/creator_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_tiny" />

                    <LinearLayout
                        android:id="@+id/creator_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/creator_rates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sound_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/insights_sound_section"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sound_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_heading"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sound_author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_small" />

                    <LinearLayout
                        android:id="@+id/sound_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/btn_sound_open"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_secondary"
                        android:clickable="true"
                        android:contentDescription="@string/insights_open_sound"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tiktok_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/insights_open_sound"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hashtag_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/insights_hashtags_section"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/hashtag_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/samples_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/insights_samples_section"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/samples_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_tiny" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/samples_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/insights_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/colorOutline"
                    android:textSize="@dimen/text_tiny"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/watch_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/watch_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btn_watch_cancel"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/cancel_selection" />

        <Button
            android:id="@+id/btn_watch_delete"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/delete_selected"
            android:textColor="@color/warning" />
    </LinearLayout>
</LinearLayout>
