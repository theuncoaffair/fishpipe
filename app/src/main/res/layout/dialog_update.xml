<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_16">

    <ImageView
        android:layout_width="@dimen/icon_hero"
        android:layout_height="@dimen/icon_hero"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_logo_fishpipe" />

    <TextView
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:text="@string/update_dialog_title"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/update_version"
        style="@style/Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.theuncoaffair.fishpipe.util.HalfScreenScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_whats_new"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/update_whats_new_body"
                style="@style/Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/update_bug_fixes"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/update_bug_fixes_body"
                style="@style/Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.theuncoaffair.fishpipe.util.HalfScreenScrollView>

    <TextView
        android:id="@+id/update_status"
        style="@style/Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:max="100"
        android:visibility="gone"
        app:trackCornerRadius="@dimen/radius_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_action"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/update_now" />
</LinearLayout>
