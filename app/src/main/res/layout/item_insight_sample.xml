<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <ImageView
        android:id="@+id/sample_cover"
        android:layout_width="@dimen/insight_thumb_width"
        android:layout_height="@dimen/insight_thumb_height"
        android:background="@drawable/bg_thumb_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_10"
        android:paddingEnd="@dimen/space_8">

        <TextView
            android:id="@+id/sample_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/sample_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>

    <TextView
        android:id="@+id/sample_views"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/colorOutline"
        android:textSize="@dimen/text_tiny" />
</LinearLayout>
