<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/type_image"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/image_loading"
        style="@style/Widget.FishPipe.Loading.Overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/image_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_6"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/image_back"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/image_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/image_story"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_4"
            android:background="@drawable/bg_photo_counter"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="@string/story_label"
            android:textColor="@color/white"
            android:textSize="@dimen/text_tiny"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/image_share"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_link"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/image_tiktok"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_tiktok"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_tiktok"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/image_more"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_more"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/image_meta_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:background="@color/scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_10"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/image_nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.theuncoaffair.fishpipe.util.MediaMetaView
            android:id="@+id/image_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/image_nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:background="@drawable/bg_photo_counter"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/image_previous"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:alpha="0.9"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_previous"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/image_next"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:alpha="0.9"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_next"
            app:tint="@color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
