<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_12">

        <ImageView
            android:id="@+id/markdown_logo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_fishpipe" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/markdown_name"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/markdown_tagline"
                style="@style/Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/markdown_version"
                style="@style/Text.Tiny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <com.theuncoaffair.fishpipe.util.HalfScreenScrollView
        android:id="@+id/markdown_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <TextView
            android:id="@+id/markdown_body"
            style="@style/Text.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/space_4"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_10"
            android:textColor="?attr/colorOnSurface" />
    </com.theuncoaffair.fishpipe.util.HalfScreenScrollView>

    <View
        android:id="@+id/markdown_footer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/markdown_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_6">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/markdown_dont_show"
            style="@style/Widget.FishPipe.CheckBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:singleLine="true"
            android:text="@string/dont_show_again"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/markdown_ok"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch"
            android:layout_marginStart="@dimen/space_4"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:text="@string/ok" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/markdown_cancel"
            style="@style/Button.Cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch"
            android:layout_marginStart="@dimen/space_4"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
