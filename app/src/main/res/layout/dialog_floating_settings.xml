<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_20">

    <TextView
        android:id="@+id/floating_size_label"
        style="@style/Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_10"
        android:textColor="?attr/colorOnSurface" />

    <SeekBar
        android:id="@+id/floating_size_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="40" />

    <TextView
        android:id="@+id/floating_opacity_label"
        style="@style/Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_10"
        android:textColor="?attr/colorOnSurface" />

    <SeekBar
        android:id="@+id/floating_opacity_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="80" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/floating_remove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Button.Secondary"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/floating_remove" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/floating_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Button.Primary"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/floating_open_app" />
</LinearLayout>
