<?xml version="1.0" encoding="utf-8"?>
<com.theuncoaffair.fishpipe.util.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/type_video"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/type"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:background="@drawable/bg_type_badge"
        android:contentDescription="@string/type_video"
        android:padding="3dp"
        android:src="@drawable/ic_video"
        app:tint="@color/white" />

    <FrameLayout
        android:id="@+id/check_wrap"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="7dp"
        android:background="@drawable/bg_check_unchecked"
        android:visibility="gone">

        <ImageView
            android:id="@+id/check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/select"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            app:tint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/more"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@null"
        android:contentDescription="@string/menu"
        android:padding="4dp"
        android:src="@drawable/ic_more"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="42dp"
        android:layout_marginBottom="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/likes_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/insights_likes"
                android:src="@drawable/ic_heart"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_tiny"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/saved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="7dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/info_saved"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_tiny"
        android:visibility="gone" />
</com.theuncoaffair.fishpipe.util.SquareFrameLayout>
