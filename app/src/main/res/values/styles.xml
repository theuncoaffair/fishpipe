<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" />
    <style name="Button" />
    <style name="Settings" />

    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Body.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Tiny" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOutline</item>
    </style>

    <style name="ShapeAppearanceOverlay.FishPipe.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.DangerOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.Cancel" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FishPipe.Button</item>
    </style>

    <style name="Widget.FishPipe.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius</item>
    </style>

    <style name="Widget.FishPipe.Loading" parent="Widget.Material3.CircularProgressIndicator">
        <item name="android:indeterminate">true</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="indicatorSize">@dimen/loading</item>
    </style>

    <style name="Widget.FishPipe.Loading.Small">
        <item name="indicatorSize">@dimen/loading_small</item>
        <item name="trackThickness">@dimen/loading_stroke</item>
    </style>

    <style name="Widget.FishPipe.Loading.Overlay">
        <item name="indicatorColor">@color/white</item>
        <item name="indicatorSize">@dimen/loading_large</item>
    </style>

    <style name="Widget.FishPipe.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="Settings.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Settings.Note" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Settings.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.FishPipe.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupElevation">@dimen/space_8</item>
    </style>

    <style name="TextAppearance.FishPipe.PopupMenu" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.FishPipe.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
